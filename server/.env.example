# Server Configuration
PORT=8080

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/improveseo

# Enhanced AI Generator Settings (optional)
